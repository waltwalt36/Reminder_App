# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset for local SQLite, or point at PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connection_notes
PGSSLMODE=prefer

# AI providers. Keep these on the backend only; never use EXPO_PUBLIC_ for them.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
PARSER_MODEL=claude-haiku-4-5
